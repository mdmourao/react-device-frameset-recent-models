{
  "name": "react-device-frameset-recent-models",
  "version": "1.4.4",
  "author": "mdmourao (https://github.com/mdmourao)",
  "contributors": [
    "Zheeeng <hi@zheeeng.me>"
  ],
  "description": "React components that wrap any content in pure-CSS device frames (iPhone 17, iPhone Duo foldable, iPhone X/8, iPad, MacBook, Android) with a device emulator, picker, zoom and landscape. TypeScript. Fork of react-device-frameset.",
  "keywords": [
    "react",
    "react-component",
    "device-frame",
    "device-mockup",
    "mockup",
    "phone-mockup",
    "iphone-mockup",
    "phone-frame",
    "device-emulator",
    "emulator",
    "simulator",
    "responsive-preview",
    "iphone",
    "iphone-17",
    "iphone-duo",
    "foldable",
    "ipad",
    "macbook",
    "android",
    "css",
    "devices.css",
    "typescript",
    "storybook"
  ],
  "homepage": "https://mdmourao.github.io/react-device-frameset-recent-models/",
  "bugs": {
    "url": "https://github.com/mdmourao/react-device-frameset-recent-models/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdmourao/react-device-frameset-recent-models.git",
    "directory": "packages/react-device-frameset"
  },
  "license": "MIT",
  "sideEffects": [
    "dist/styles/*.css"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./*": "./dist/*"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:lib": "pnpm build:lib -- --watch",
    "dev:css": "gulp watchBuildCss",
    "build": "pnpm build:pack",
    "build:lib": "tsup src/index.ts --format cjs,esm --dts --clean",
    "build:css": "gulp buildCss",
    "build:readme": "gulp genSignature && gulp moveReadme",
    "build:pack": "pnpm build:lib && pnpm build:css && pnpm build:readme"
  },
  "devDependencies": {
    "@types/react": "^17.0.39",
    "gulp": "^4.0.2",
    "gulp-autoprefixer": "^8.0.0",
    "gulp-rename": "^2.0.0",
    "gulp-replace": "^1.1.3",
    "gulp-sass": "^5.1.0",
    "gulp-sourcemaps": "^3.0.0",
    "sass": "1.64.1",
    "tsup": "^7.1.0"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0"
  }
}
